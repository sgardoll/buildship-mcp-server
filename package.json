{
  "name": "buildship-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for creating and editing BuildShip nodes and workflows in this repository.",
  "license": "MIT",
  "author": "Stuart Gardoll",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgardoll/buildship-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/sgardoll/buildship-mcp-server/issues"
  },
  "homepage": "https://github.com/sgardoll/buildship-mcp-server#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "buildship",
    "claude",
    "ai-tools"
  ],
  "type": "module",
  "bin": {
    "buildship-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "node dist/index.js --check",
    "test": "tsc && node --test",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts",
    "prepare": "tsc",
    "init-remote": "node scripts/setup-remote.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "typescript": "^5.5.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
